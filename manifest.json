{
  "manifest_version": 3,
  "name": "Shopee Order to Sheet - Xuất Đơn & Cập Nhật Hoàn Hủy",
  "version": "1.1.0",
  "description": "Xuất đầy đủ thông tin đơn hàng Shopee và cập nhật trạng thái hoàn hủy, số tiền thực nhận vào Google Sheet (Hỗ trợ Chrome & Firefox)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "cookies",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://banhang.shopee.vn/*",
    "https://script.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://api.github.com/*",
    "https://github.com/*",
    "https://*.githubusercontent.com/*",
    "https://*.github.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Shopee Order Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://banhang.shopee.vn/*"],
      "css": ["content/content.css"],
      "js": ["content/content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/inject.js", "icons/*"],
      "matches": ["https://banhang.shopee.vn/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "shopee-order-sheet@local",
      "strict_min_version": "109.0"
    }
  }
}
